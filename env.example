# ==============================================================================
# ContextForge — Environment Variable Template
# ==============================================================================
# Copy this file to `.env` and fill in all required values.
# NEVER commit the `.env` file. It is in `.gitignore`.
# Variables marked [REQUIRED] have no safe default and MUST be set.
# Variables marked [OPTIONAL] have sensible defaults for local development.
# Variables marked [SECRET — HIGH] must be rotated immediately if exposed.
# Variables marked [SECRET — MEDIUM] should be treated as sensitive.
# Variables marked [SECRET — LOW] are non-sensitive configuration values.
# ==============================================================================


# ------------------------------------------------------------------------------
# SECTION 1: Core Platform & App URLs
# ------------------------------------------------------------------------------

# The base URL of the FastAPI backend. Used by the frontend to make API calls.
# Local default: http://localhost:8000 — set to Railway URL in production.
# Format: https://{your-railway-project}.up.railway.app
# Security severity: [SECRET — LOW] (public URL, but avoid exposing infra names)
VITE_API_BASE_URL=http://localhost:8000

# The public URL of the frontend. Used for CORS allow-list and redirect URLs.
# Local default: http://localhost:5173 (Vite default port)
# Format: https://{your-vercel-project}.vercel.app
# Security severity: [SECRET — LOW]
APP_FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the FastAPI backend.
# Must include all frontend URLs (local + Vercel preview URLs + production).
# Format: http://localhost:5173,https://contextforge.vercel.app
# Security severity: [SECRET — LOW]
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application environment. Controls: FastAPI docs visibility, log levels, debug flags.
# Values: development | staging | production
# Default: development
# Security severity: [SECRET — LOW]
APP_ENV=development

# Log level for the FastAPI backend.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: DEBUG in development, INFO in production.
# Security severity: [SECRET — LOW]
LOG_LEVEL=DEBUG

# Session TTL in seconds. Sessions expire this many seconds after last activity.
# Default: 7200 (2 hours). Minimum recommended: 1800 (30 minutes).
# Security severity: [SECRET — LOW]
SESSION_TTL_SECONDS=7200

# Maximum number of files allowed per session (uploads).
# Default: 5. Hard max: 10 (API contract limit).
# Security severity: [SECRET — LOW]
MAX_FILES_PER_SESSION=5

# Maximum file upload size in bytes.
# Default: 20971520 (20 MB).
# Security severity: [SECRET — LOW]
MAX_FILE_SIZE_BYTES=20971520


# ------------------------------------------------------------------------------
# SECTION 2: Gemini API Keys & Model Configuration
# Purpose: These keys authenticate calls to Google AI Studio (Gemini API).
#          Multiple keys support the rotation pool for rate limit avoidance.
#          Add as many keys as your team has. At least 1 is required.
#          For the hackathon demo, add one key per team member.
# Format: AIza... (39 characters, starts with AIza)
# Free tier: Gemini 1.5 Flash — 15 RPM, 1M tokens/day
#            Gemini 1.5 Pro — 2 RPM, 50 requests/day
# Security severity: [SECRET — HIGH] Rotate immediately if exposed.
# ------------------------------------------------------------------------------

# [REQUIRED] Primary Gemini API key. Always used first.
GEMINI_API_KEY_1=

# [OPTIONAL] Additional Gemini API keys for rotation pool.
# The system rotates through all non-empty keys in order.
# Add more by appending GEMINI_API_KEY_3, _4, etc. — the key_pool.py loader
# reads all GEMINI_API_KEY_N variables where N is an integer.
GEMINI_API_KEY_2=

# Gemini model for the swarm (6 parallel agents). Must be a Flash-tier model.
# Default: gemini-1.5-flash — fast, cheap, 1M token context.
# Do not change to Pro here — Pro is reserved for evaluator and merge.
# Security severity: [SECRET — LOW]
GEMINI_FLASH_MODEL=gemini-1.5-flash

# Gemini model for the Evaluator and Merge Engine. Must be a Pro-tier model.
# Default: gemini-1.5-pro — higher reasoning quality for synthesis.
# Security severity: [SECRET — LOW]
GEMINI_PRO_MODEL=gemini-1.5-pro

# Gemini model for Voice transcription fallback (Gemini Audio).
# Default: gemini-1.5-flash (same as swarm — audio processing is fast).
# Security severity: [SECRET — LOW]
GEMINI_AUDIO_MODEL=gemini-1.5-flash

# Maximum tokens to request from Gemini Flash per agent call.
# Default: 4096. Increase for longer BRDs; check daily token quota.
# Security severity: [SECRET — LOW]
GEMINI_FLASH_MAX_TOKENS=4096

# Maximum tokens to request from Gemini Pro per evaluator/merge call.
# Default: 8192. The merge engine needs more tokens to synthesise 6 BRDs.
# Security severity: [SECRET — LOW]
GEMINI_PRO_MAX_TOKENS=8192

# Timeout in seconds for Gemini Flash calls (swarm agents).
# Default: 30. Increase to 45 on slow networks.
# Security severity: [SECRET — LOW]
GEMINI_FLASH_TIMEOUT_SECONDS=30

# Timeout in seconds for Gemini Pro calls (evaluator and merge).
# Default: 60. Pro calls are slower due to higher reasoning overhead.
# Security severity: [SECRET — LOW]
GEMINI_PRO_TIMEOUT_SECONDS=60


# ------------------------------------------------------------------------------
# SECTION 3: Google Cloud Platform (GCP) Configuration
# Purpose: GCS stores agent JSON outputs. BigQuery logs context harvest data.
#          Vertex AI orchestrates agent jobs and handles retries.
# Security severity: [SECRET — HIGH] The service account JSON is a master credential.
# ------------------------------------------------------------------------------

# [REQUIRED] Your GCP project ID. Found in the GCP Console header.
# Format: my-project-id-123456
# Security severity: [SECRET — MEDIUM]
GCP_PROJECT_ID=

# [REQUIRED] GCS bucket name where agent outputs and merged BRDs are stored.
# Create this bucket in GCP Console: Cloud Storage → Create Bucket.
# Recommended name: contextforge-outputs-{your-initials}
# Format: contextforge-outputs
# Security severity: [SECRET — MEDIUM]
GCS_BUCKET_NAME=contextforge-outputs

# [REQUIRED] BigQuery dataset name where context harvest logs are stored.
# Create this dataset in BigQuery Console under your GCP project.
# Default: contextforge_data
# Security severity: [SECRET — MEDIUM]
BIGQUERY_DATASET=contextforge_data

# [REQUIRED] GCP region for Vertex AI orchestration.
# Default: us-central1 — broadest Vertex AI feature support.
# Other options: europe-west1, asia-south1 (for India-hosted demo).
# Security severity: [SECRET — LOW]
VERTEX_AI_LOCATION=us-central1

# [REQUIRED] GCP Service Account JSON key, base64-encoded.
# Generate in GCP Console: IAM & Admin → Service Accounts → Keys → Create Key → JSON.
# Required roles: Storage Object Admin, BigQuery Data Editor, Vertex AI User.
# Encode with: base64 -w 0 my-service-account-key.json
# NEVER commit the raw JSON file. Use base64 encoding here.
# Security severity: [SECRET — HIGH] Rotate if exposed. Revoke in GCP Console immediately.
GCP_SERVICE_ACCOUNT_JSON_B64=

# GCS path prefix pattern. Used by storage.py to construct blob paths.
# Default: {session_id}/ — all files for a session live under this prefix.
# Do not change without updating gcp/storage.py.
# Security severity: [SECRET — LOW]
GCS_SESSION_PREFIX_PATTERN={session_id}/

# GCS blob name for the PDF output file.
# Default: output.pdf
# Security severity: [SECRET — LOW]
GCS_PDF_BLOB_NAME=output.pdf


# ------------------------------------------------------------------------------
# SECTION 4: Context Harvester — Third-Party API Keys
# Purpose: These keys authenticate calls to external context sources.
#          Each is used by the Context Harvester when region/industry is detected.
# ------------------------------------------------------------------------------

# [REQUIRED for full PS42 compliance] NewsAPI key.
# Get yours at: https://newsapi.org/register
# Free tier: 100 requests/day. Sufficient for hackathon.
# Format: 32-character alphanumeric string.
# Security severity: [SECRET — MEDIUM]
NEWS_API_KEY=

# [OPTIONAL] Crunchbase Basic API key.
# Get yours at: https://data.crunchbase.com/docs/using-the-api
# Free tier: limited requests. Used for competitor funding data.
# Format: varies by registration.
# Security severity: [SECRET — MEDIUM]
CRUNCHBASE_API_KEY=

# World Bank API base URL. This API requires no authentication key.
# Default: https://api.worldbank.org/v2
# Only change if you need to proxy through your own service.
# Security severity: [SECRET — LOW]
WORLDBANK_API_BASE_URL=https://api.worldbank.org/v2

# Timeout in seconds for all Context Harvester API calls.
# Default: 10. Increase to 15 if you observe timeouts on slow networks.
# Security severity: [SECRET — LOW]
CONTEXT_HARVESTER_TIMEOUT_SECONDS=10

# Minimum input length in characters before the swarm is allowed to fire.
# Default: 50. Prevents the swarm from running on a 2-word idea.
# Security severity: [SECRET — LOW]
MIN_INTAKE_LENGTH_CHARS=50


# ------------------------------------------------------------------------------
# SECTION 5: Rate Limiting Configuration
# Purpose: Controls the in-process rate limiter (slowapi or custom dict).
#          These match the thresholds defined in PRD.md §6.2.
# Security severity: [SECRET — LOW] for all entries in this section.
# ------------------------------------------------------------------------------

# Max session creation requests per IP per 15-minute window.
# Default: 10
RATE_LIMIT_SESSION_CREATE_PER_15MIN=10

# Max chat turns per session per minute.
# Default: 30
RATE_LIMIT_CHAT_PER_MIN=30

# Max generation triggers per IP per hour.
# Default: 5
RATE_LIMIT_GENERATE_PER_HOUR=5

# Max GET requests per IP per minute (all read endpoints).
# Default: 60
RATE_LIMIT_GET_PER_MIN=60

# Global max requests per IP per minute (all endpoints combined).
# Default: 200
RATE_LIMIT_GLOBAL_PER_MIN=200


# ------------------------------------------------------------------------------
# SECTION 6: Output & PDF Generation
# Purpose: Controls how the final BRD PDF is generated by ReportLab.
# Security severity: [SECRET — LOW] for all entries in this section.
# ------------------------------------------------------------------------------

# PDF author metadata field.
# Default: ContextForge — BRD Generator
PDF_AUTHOR=ContextForge — BRD Generator

# PDF subject metadata field.
# Default: AI-Generated Business Requirements Document
PDF_SUBJECT=AI-Generated Business Requirements Document

# PDF creator metadata field (shown in document properties).
# Default: ContextForge v1.0
PDF_CREATOR=ContextForge v1.0

# Google Docs API credentials JSON (base64-encoded), for optional Google Docs output.
# [OPTIONAL] Only required if you want the "Open as Google Doc" feature.
# Get from: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Security severity: [SECRET — HIGH] if set. Rotate if exposed.
GOOGLE_DOCS_OAUTH_CREDENTIALS_B64=


# ------------------------------------------------------------------------------
# SECTION 7: Observability & Internal Config
# Security severity: [SECRET — LOW] for all entries in this section.
# ------------------------------------------------------------------------------

# Whether to print full Gemini API response bodies to DEBUG logs.
# Default: false. Set to true ONLY in local development for debugging.
# NEVER set true in production — responses may contain sensitive business ideas.
DEBUG_LOG_GEMINI_RESPONSES=false

# Whether to write agent outputs to GCS on every run.
# Default: true. Set to false only for local unit testing to save quota.
GCS_WRITE_ENABLED=true

# Whether to write context harvest logs to BigQuery on every run.
# Default: true. Set to false only for local unit testing to save quota.
BIGQUERY_WRITE_ENABLED=true

# Whether Vertex AI job tracking is enabled.
# Default: true. Set to false to skip Vertex AI during local development.
VERTEX_AI_ENABLED=true

# Internal request ID header name. Used for distributed tracing.
# Default: X-Request-ID
REQUEST_ID_HEADER=X-Request-ID
